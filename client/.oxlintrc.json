{
  // The client's lint (oxlint 1.90.0, `npm run lint`): every correctness rule of the default plugins and of React's,
  // with React's hook rules and React Compiler's rules on refs during render and on state set inside an effect.
  // ESLint is not used: its TypeScript parser does not support TypeScript 7.
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["eslint", "typescript", "unicorn", "oxc", "react"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "react/rules-of-hooks": "error",
    "react/exhaustive-deps": "error",
    "react/refs": "error",
    "react/set-state-in-effect": "error"
  },
  "ignorePatterns": ["out/**"]
}
