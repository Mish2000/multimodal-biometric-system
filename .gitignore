# Build output
bin/
obj/
.vs/
*.user

# Local-only material at the repository root, never committed
/captures/
/local/

# Biometric samples and anything derived from them must never enter git
*.png
*.jpg
*.jpeg
*.bmp
*.tif
*.tiff
*.wsq
*.jp2
*.wav
*.flac
*.mp3
*.ogg
*.webm
*.npy
*.npz
# The one exception: the README's screenshots of the design prototypes, synthetic data only
!/docs/assets/screenshots/*.jpg

# IDE settings (PyCharm, WebStorm, DataGrip): machine-specific paths, never committed
.idea/

# Python caches
__pycache__/
.pytest_cache/

# Client dependencies and build output (installed from client/package-lock.json)
node_modules/
/client/out/
/client/dist/
